---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/site.css';
interface Props { title?: string; description?: string; bodyClass?: string; image?: string; published?: Date; updated?: Date }
const { title = '폴시랩', description = '개발과 프로젝트, 그리고 일상의 기록.', bodyClass = '', image = '/wp-content/uploads/2020/07/falsylab.jpg', published, updated } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site!);
const socialImage = new URL(image, Astro.site!);
const nav = [{ name: 'About', url: '/about/' }, { name: 'Programming', url: '/programming/' }, { name: 'Project', url: '/project/' }, { name: 'Blog', url: '/blog/' }];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <title>{title === '폴시랩' ? title : `${title} | 폴시랩`}</title>
    <meta name="description" content={description} />
    <meta name="author" content="falsy" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/theme/img/favicon_v4.ico" />
    <link rel="alternate" type="application/rss+xml" title="폴시랩" href="/rss.xml" />
    <meta property="og:site_name" content="폴시랩" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <link rel="stylesheet" href="/theme/css/style.css" />
    <link rel="stylesheet" href="/theme/css/responsive_style.css" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('falsylab-theme');
        const legacy = document.cookie.includes('dark_mode=true');
        document.documentElement.classList.toggle('dark-mode', saved ? saved === 'dark' : legacy || matchMedia('(prefers-color-scheme: dark)').matches);
      } catch { /* Use the default theme when storage is unavailable. */ }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(published ? {
      '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title,
      datePublished: published.toISOString(), dateModified: (updated ?? published).toISOString(),
      author: { '@type': 'Person', name: 'falsy', url: 'https://falsy.me/about/' },
      image: socialImage.href, mainEntityOfPage: canonical.href,
    } : { '@context': 'https://schema.org', '@type': 'WebSite', name: '폴시랩', url: 'https://falsy.me' }).replace(/</g, '\\u003c')} />
    {import.meta.env.PROD && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-079VSG4JZ4" />}
    {import.meta.env.PROD && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date()); gtag('config', 'G-079VSG4JZ4');
    </script>}
    {import.meta.env.PROD && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js" />}
    {import.meta.env.PROD && <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({
        google_ad_client: 'ca-pub-8365775889087902', enable_page_level_ads: true,
      });
    </script>}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">본문으로 이동</a>
    <header id="page_header"><div class="container">
      <h1><a href="/"><img src="/wp-content/uploads/2018/11/logo.png" alt="폴시랩" width="160" /></a></h1>
      <nav aria-label="주 메뉴">{nav.map((item) => <a href={item.url} aria-current={Astro.url.pathname === item.url ? 'page' : undefined}>{item.name}</a>)}</nav>
      <ThemeToggle />
    </div></header>
    <main id="main-content"><slot /></main>
    <footer id="page_footer"><div class="container"><section><p id="copyright">© {new Date().getFullYear()} Falsy.</p></section></div></footer>
  </body>
</html>
